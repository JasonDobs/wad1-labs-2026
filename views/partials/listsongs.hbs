{{#if songs}}

    <table class="ui unstackable striped table">
        <thead>
        <tr>
            <th>Song</th>
            <th>Artist</th>
        </tr>
        </thead>
        <tbody>
        {{#each songs}}
            <tr>
                <td>
                    {{title}}
                </td>
                <td>
                    {{artist}}
                </td>
            </tr>
        {{/each}}
        </tbody>
    </table>

{{/if}}
